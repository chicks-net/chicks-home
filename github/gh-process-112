#!/usr/bin/env bash

if [[ ! -d .git ]]; then
	echo not in the root of a git repo
	exit 1
fi

if [[ ! -d .just ]]; then
	echo no .just dir, seems bad
	exit 2
fi

echo "sanity checks look ok"

just branch gh-process-11-2

if [[ -f .just/lib/template_sync_test.sh ]]; then
	git rm .just/lib/template_sync_test.sh
fi
if [[ -f .just/lib/cue_sync_test.sh ]]; then
	git rm .just/lib/cue_sync_test.sh
fi

just update_from_template

git add .just/gh-process.just .just/compliance.just .just/copilot.just .just/cue-verify.just .just/lib/common.sh .just/lib/generate_checksums.sh .just/repo-toml.just .just/shellcheck.just .just/lib/repo_urls.sh .just/lib/template_update.sh
git stp

gum spin --title "Double checking..." sleep 3
git cim '🗳️ [just] gh-process v11.2 release confirms before going backwards, compliance treats media as advisory, not malware'
#just pr

echo "$0 completed"
